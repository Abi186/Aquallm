APP_NAME=AquaLLM
APP_ENV=development
DEBUG=True

DB_HOST=localhost
DB_PORT=5432
DB_NAME=aquallm
DB_USER=postgres
DB_PASSWORD=

API_HOST=127.0.0.1
API_PORT=8000

FRONTEND_URL=http://localhost:5173

LLM_PROVIDER=huggingface

# ---- Local LLM (Ollama) ----
OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5:7b = better answers (needs ~8 GB free RAM)
# qwen2.5:3b = lighter, for low-RAM laptops
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=180

# ---- Knowledge base (RAG) ----
RAG_ENABLED=True
OLLAMA_EMBED_MODEL=nomic-embed-text
RAG_TOP_K=3
RAG_MIN_SCORE=0.45
